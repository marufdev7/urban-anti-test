# Copy to .env.local (git-ignored) and fill in real values. Placeholders only in this file.
# Variable set from docs/06-devops-guide.md §3.2. Additional variables are added in A4 (T0.3).

# Settings split is base/dev/prod (T0.3). Use .prod in deployed environments.
DJANGO_SETTINGS_MODULE=urbenmend.settings.dev
DJANGO_SECRET_KEY=change-me-local-dev-only
DJANGO_DEBUG=true
# ⚠️ `api` is listed for the T10.4 load generator, which reaches the API over the compose network
# as http://api:8080. This variable OVERRIDES settings/dev.py's default, so omitting `api` here
# makes every request from the loadgen container a 400 — which a load run reports as a very fast
# failure rather than as the misconfiguration it is. Harmless otherwise: it is a hostname that only
# resolves inside the compose network, and prod sets its own value.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api


# NOTE: the scheme is postgis://, not postgres:// — it is what selects the
# django.contrib.gis.db.backends.postgis engine when django-environ parses the URL.
DATABASE_URL=postgis://urbenmend:urbenmend@db:5432/urbenmend

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Idempotency windows for POST /reports (T2.3, BR-5, API §4.6). Our policy, not spec-derived —
# §4.6 says the retention window is deployment configuration, so these are the defaults, not a
# contract clients may depend on. Both are seconds, and they are deliberately far apart:
# IN_PROGRESS is the backstop for a request whose process died mid-write, RETENTION is how long a
# completed acknowledgement can be replayed. NOTE: these live in the Redis `default` cache, so
# flushing it drops every held key and an in-flight retry becomes a fresh submission.
IDEMPOTENCY_RETENTION_SECONDS=86400
IDEMPOTENCY_IN_PROGRESS_SECONDS=60
IDEMPOTENCY_KEY_MAX_LENGTH=255

STORAGE_ENDPOINT=http://storage:9000
STORAGE_BUCKET=urbenmend-media
# ⚠️ Must match docker-compose.yml's MINIO_ROOT_USER / MINIO_ROOT_PASSWORD. Omit them and
# base.py's `default=""` makes boto3 send unsigned requests: every upload AND every presigned
# URL fails with NoCredentialsError, because signing needs credentials too. These are the local
# MinIO root values, already in docker-compose.yml in plaintext — not secrets. `prod.py` requires
# the same two variables with no default, so a deployment cannot boot without real ones.
STORAGE_ACCESS_KEY=urbenmend
STORAGE_SECRET_KEY=urbenmend-local-dev

# Email — verification codes and notifications (FR-1, ❓Q5). ⚠️ By default NOTHING is sent from a
# dev box: dev.py's EMAIL_BACKEND is the console backend, so a verification code is printed to
# `docker compose logs api` instead of emailed. Read it out of the log; no provider is needed to
# develop against FR-1. The four values below are therefore INERT until DJANGO_EMAIL_BACKEND is
# also set — filling them in alone changes nothing, which is the safety property, not an
# oversight. Once switched, real mail goes to real addresses.
# Same variable NAMES as prod.py, where all four are required with no default.
#DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Mailjet SMTP relay. 587 is STARTTLS; 2525 and 25 also work, 465 is implicit SSL.
# ⚠️ Mailjet takes TWO distinct credentials and neither is a literal string: EMAIL_HOST_USER is the
# API Key (public) and EMAIL_HOST_PASSWORD is the Secret Key (private), both 32-char hex values from
# Account Settings → REST API → API Key Management. Reusing one key for both fields fails AUTH.
EMAIL_HOST=in-v3.mailjet.com
EMAIL_PORT=587
EMAIL_HOST_USER=<paste-your-mailjet-API-KEY-public>
EMAIL_HOST_PASSWORD=<paste-your-mailjet-SECRET-KEY-private>
# ⚠️ Must be a sender address validated in Mailjet — it has no shared test sender, so an
# unvalidated From is rejected by the provider no matter how the app is configured.
DEFAULT_FROM_EMAIL=UrbanMend <your-validated-sender@example.com>
# 587 is STARTTLS (TLS on, SSL off); 465 is implicit SSL (TLS off, SSL on). ⚠️ Both enabled
# raises at startup — smtplib would negotiate STARTTLS on an already-wrapped socket and hang.
#EMAIL_USE_TLS=true
#EMAIL_USE_SSL=false

# Photo upload limits (T2.4/T2.5, FR-7, API §6.4). Our policy, not spec-derived — FR-7 says
# "enforce size/type limits" without fixing numbers, so these are defaults, not a contract.
# MEDIA_ALLOWED_IMAGE_FORMATS holds Pillow format names and is matched against the *detected*
# format, never the client's Content-Type header.
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_ALLOWED_IMAGE_FORMATS=JPEG,PNG,WEBP
MEDIA_MAX_DIMENSION=2048
MEDIA_THUMBNAIL_DIMENSION=320
MEDIA_IMAGE_QUALITY=82
MEDIA_MAX_PER_REPORT=5

# Submission rate limits (T2.9, FR-33, API §4.5). Our policy, not spec-derived — §4.5 requires
# "tighter buckets on … report submission" without fixing numbers. Syntax is `<count>/<n><unit>`
# with unit s|m|h|d, parsed by ScopedWindowRateThrottle (NOT by DRF, whose parser silently drops
# the count prefix). Deliberately separate from the AUTH_THROTTLE_RATE_* windows above: those are
# sized for credential guessing and would cut a citizen off after their fifth photo.
#   REPORT — per account, POST /reports. Also the per-account LLM cost ceiling (NFR-13).
#   MEDIA  — per account, POST /media. Higher, but NOT report×MEDIA_MAX_PER_REPORT: the upload is
#            the expensive endpoint, so it is the one that should bind first under photo-heavy load.
#   IP     — per source address, SHARED by both endpoints. The Sybil limit (PRD §T3); size it for
#            carrier NAT, since many citizens can share one address.
# NOTE: these counters live in the Redis `default` cache, so flushing it resets every window.
SUBMISSION_THROTTLE_RATE_REPORT=20/1h
SUBMISSION_THROTTLE_RATE_MEDIA=60/1h
SUBMISSION_THROTTLE_RATE_IP=120/1h

# --- T10.4 load runs only. NEVER DEPLOY THESE VALUES. ---------------------------------------
# A load generator is a single IP and a handful of accounts, so at the defaults above the whole
# fleet is capped at two writes a minute and the run measures the throttle instead of the API.
# Raise ONLY these three, ONLY for the duration of a run, then restore them and re-run the suite:
#
#   SUBMISSION_THROTTLE_RATE_REPORT=100000/1h
#   SUBMISSION_THROTTLE_RATE_MEDIA=100000/1h
#   SUBMISSION_THROTTLE_RATE_IP=100000/1h
#
# ⚠️ **The AUTH_THROTTLE_RATE_* buckets stay untouched**, and that is the point of the harness's
# design: it replays session cookies minted by `seed_load_dataset` instead of calling /auth/login,
# so credential-guessing limits are never in the measurement path and never need weakening.
# ⚠️ Verifying the limiters *under* concurrency is T10.1, which needs them at production rates —
# leaving these raised anywhere would make that task unverifiable and the deployment a Sybil
# target (FR-33, PRD §T3). See docs/09-operations.md § T10.4 for the full procedure.


# Classification (T3.1–T3.3, FR-9/FR-10/FR-13a, NFR-13, Arch §6). Our numbers, not spec-derived —
# NFR-13 requires a token cap, a timeout and bounded retries without naming values.
#
# CLASSIFICATION_LLM_PROVIDER is either a vendor shorthand or a dotted path to an llm.LLMProvider
# subclass. ❓Q9 is resolved to **Google AI Studio** (2026-08-25), but this committed template still
# ships UnconfiguredLLMProvider, which always raises — deliberately, because a template is what a
# fresh clone and CI get, and neither has an API key. A deployment with nothing set here classifies
# through the FR-13a keyword fallback instead of failing (NFR-4). A wrong path raises
# ImproperlyConfigured; it does NOT degrade silently.
#
# To turn the LLM on in .env.local, set `google_ai_studio` here and paste a key below. Two shorthands
# are recognised, both needing an endpoint/key/model triple a dotted path cannot supply:
#   google_ai_studio   — Google AI Studio (Gemini), native generateContent API. ⚠️ P7: Google's
#                        UNPAID tier may use submitted prompts to improve its products, and report
#                        text is what gets sent. Free tier is fine against your own test reports;
#                        a deployment handling real submissions needs billing enabled on the key.
#   openai_compatible  — anything speaking OpenAI's chat-completions contract.
CLASSIFICATION_LLM_PROVIDER=urbenmend.classification.llm.UnconfiguredLLMProvider
# ⚠️ Endpoint, model and provider are one decision in three variables — a model name from one vendor
# against another's endpoint is a 404, which T3.4 reads as an outage and keyword-classifies through.
# The pair below matches google_ai_studio; for openai_compatible use e.g. https://api.openai.com/v1
# with gpt-4o-mini. ⚠️ For Google this ends at /v1beta — the provider appends
# /models/<model>:generateContent, and /v1beta/openai is the *compatibility* layer, not this one.
CLASSIFICATION_LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
# ⚠️ Left EMPTY on purpose — a non-empty placeholder satisfies the "key is required" guard in
# classification/services.py and turns a missing key into a 401 from the provider instead of a
# clear ImproperlyConfigured at startup.
CLASSIFICATION_LLM_API_KEY=
CLASSIFICATION_LLM_MODEL=gemini-2.5-flash
# Google only. ⚠️ Raise above 0 ONLY together with MAX_OUTPUT_TOKENS: Gemini 2.5 bills reasoning
# against the same output cap, so a thinking model exhausts an answer-sized budget and returns an
# empty candidate (finishReason MAX_TOKENS) on every report. -1 lets the model decide (unbounded
# spend, NFR-13); empty omits the field, which pre-2.5 models require.
CLASSIFICATION_LLM_THINKING_BUDGET=0
CLASSIFICATION_LLM_MAX_OUTPUT_TOKENS=300
CLASSIFICATION_LLM_TIMEOUT_SECONDS=10.0
CLASSIFICATION_LLM_MAX_ATTEMPTS=2
CLASSIFICATION_LLM_BACKOFF_SECONDS=0.5
CLASSIFICATION_LLM_CACHE_SECONDS=86400
CLASSIFICATION_LLM_USER_RATE_LIMIT=20
CLASSIFICATION_LLM_GLOBAL_RATE_LIMIT=500
CLASSIFICATION_LLM_RATE_WINDOW_SECONDS=3600
CLASSIFICATION_LLM_DAILY_TOKEN_BUDGET=1000000
CLASSIFICATION_LLM_CIRCUIT_FAILURE_THRESHOLD=3
CLASSIFICATION_LLM_CIRCUIT_RECOVERY_SECONDS=60

# Confidence the keyword fallback reports on a match / on no match. ❓Q10 (the accuracy bar, and so
# the low-confidence review threshold) is OPEN — these are not tuned against a threshold that does
# not exist yet. The fallback's default severity band is deliberately NOT configurable; see
# classification/keywords.py DEFAULT_SEVERITY.
CLASSIFICATION_FALLBACK_MATCHED_CONFIDENCE=0.5
CLASSIFICATION_FALLBACK_UNMATCHED_CONFIDENCE=0.1
# Q10 is open. Leave blank to store confidence without flagging reports for review.
# CLASSIFICATION_LOW_CONFIDENCE_THRESHOLD=0.2
