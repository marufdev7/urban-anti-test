# UrbanMend production environment template for docker-compose.prod.yml.
#
# Copy this to `.env.production` on the Azure VM, replace every `change-*`/example value, and set:
#   chmod 600 .env.production
# Never commit the populated file. Keep values single-line and avoid `$` unless escaped as `$$`,
# because Docker Compose performs variable interpolation before passing values to containers.

# --------------------------------------------------------------------------------------
# Compose and public endpoints
# --------------------------------------------------------------------------------------
# Immutable SHA tag produced by CI. Never use `latest`.
APP_IMAGE=ghcr.io/owner/repository:git-sha
URBENMEND_ENV_FILE=.env.production

API_DOMAIN=api.example.com
STORAGE_DOMAIN=storage.example.com
ACME_EMAIL=ops@example.com

# Must be greater than MEDIA_MAX_UPLOAD_BYTES after accounting for multipart overhead.
PROXY_MAX_REQUEST_BODY=12MB
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5

# Override only during an intentional, tested image upgrade.
POSTGIS_IMAGE=postgis/postgis:17-3.5
REDIS_IMAGE=redis:8-alpine
MINIO_IMAGE=minio/minio:latest
MINIO_CLIENT_IMAGE=minio/mc:latest
CADDY_IMAGE=caddy:2.10-alpine

# --------------------------------------------------------------------------------------
# Django
# --------------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=urbenmend.settings.prod
DJANGO_SECRET_KEY=change-to-a-generated-high-entropy-django-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.example.com

# Include scheme and hostname. Leave empty only when the browser uses the API origin directly.
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com

# Start with 300 seconds for the first HTTPS rehearsal. Increase after TLS is confirmed stable.
DJANGO_HSTS_SECONDS=300
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
DJANGO_LOG_LEVEL=INFO

# --------------------------------------------------------------------------------------
# PostgreSQL/PostGIS
# --------------------------------------------------------------------------------------
POSTGRES_DB=urbenmend
POSTGRES_USER=urbenmend
POSTGRES_PASSWORD=change-to-a-generated-postgres-password

# URL-encode reserved URL characters in the username/password. The postgis:// scheme is required.
DATABASE_URL=postgis://urbenmend:change-to-a-generated-postgres-password@db:5432/urbenmend
# Private, same-host Docker network only. Use require/verify-full for a managed remote database.
DATABASE_SSLMODE=disable

# --------------------------------------------------------------------------------------
# Transactional email (SMTP)
# --------------------------------------------------------------------------------------
# Mailjet SMTP relay. Create the key pair in Mailjet and use it only on the Azure VM; never commit
# it. Host/port verified live: in-v3.mailjet.com:587 (STARTTLS, AUTH PLAIN LOGIN); 2525 and 25 are
# STARTTLS alternates if the host blocks 587, and 465 is implicit SSL (then set EMAIL_USE_SSL=true
# and EMAIL_USE_TLS=false — prod.py raises at import if both are enabled).
#
# ⚠️ TWO distinct credentials, neither a literal string. From Account Settings → REST API → API Key
# Management: EMAIL_HOST_USER is the API Key (public), EMAIL_HOST_PASSWORD is the Secret Key
# (private), both 32-char hex. Reusing one value for both fields fails AUTH with 535.
#
# ⚠️ Authenticate the sending domain in Mailjet (SPF + DKIM) before going live, and use a From
# address on it. Mailjet rejects an unvalidated sender outright, and prod.py has no default for
# EMAIL_HOST/USER/PASSWORD/DEFAULT_FROM_EMAIL — a missing one crash-loops every app container.
EMAIL_HOST=in-v3.mailjet.com
EMAIL_PORT=587
EMAIL_HOST_USER=<paste-your-mailjet-API-KEY-public>
EMAIL_HOST_PASSWORD=<paste-your-mailjet-SECRET-KEY-private>
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT_SECONDS=10
DEFAULT_FROM_EMAIL=UrbanMend <noreply@your-authenticated-domain.example>
SERVER_EMAIL=UrbanMend Errors <errors@your-authenticated-domain.example>

# --------------------------------------------------------------------------------------
# Redis: cache/session/throttles use DB 0; Celery uses DB 1
# --------------------------------------------------------------------------------------
REDIS_PASSWORD=change-to-a-generated-redis-password
REDIS_URL=redis://:change-to-a-generated-redis-password@redis:6379/0
CELERY_BROKER_URL=redis://:change-to-a-generated-redis-password@redis:6379/1

# --------------------------------------------------------------------------------------
# MinIO object storage
# --------------------------------------------------------------------------------------
# These values also initialize MinIO. Keep the bucket private.
STORAGE_ENDPOINT=https://storage.example.com
STORAGE_BUCKET=urbenmend-media
STORAGE_ACCESS_KEY=change-to-a-generated-minio-access-key
STORAGE_SECRET_KEY=change-to-a-generated-minio-secret-key
AWS_REGION=us-east-1

# --------------------------------------------------------------------------------------
# Report, media, search, and proximity policy
# --------------------------------------------------------------------------------------
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_ALLOWED_IMAGE_FORMATS=JPEG,PNG,WEBP
MEDIA_MAX_DIMENSION=2048
MEDIA_THUMBNAIL_DIMENSION=320
MEDIA_IMAGE_QUALITY=82
MEDIA_MAX_PER_REPORT=5
REPORT_SEARCH_MAX_RADIUS_M=50000
ISSUE_PROXIMITY_RADIUS_M=500
ISSUE_PROXIMITY_LIMIT=3

IDEMPOTENCY_RETENTION_SECONDS=86400
IDEMPOTENCY_IN_PROGRESS_SECONDS=60
IDEMPOTENCY_KEY_MAX_LENGTH=255

# --------------------------------------------------------------------------------------
# Authentication and submission throttles
# --------------------------------------------------------------------------------------
AUTH_THROTTLE_RATE_ANON=10/15m
AUTH_THROTTLE_RATE_IDENTITY=5/15m
AUTH_THROTTLE_RATE_USER=20/15m
SUBMISSION_THROTTLE_RATE_REPORT=20/1h
SUBMISSION_THROTTLE_RATE_MEDIA=60/1h
SUBMISSION_THROTTLE_RATE_IP=120/1h

# --------------------------------------------------------------------------------------
# Classification
# --------------------------------------------------------------------------------------
# ❓Q9 is resolved to **Google AI Studio** (2026-08-25). Leave the unconfigured provider during
# infrastructure bring-up — the keyword fallback stays active and reports are still triaged — then
# switch to `google_ai_studio` once the key is provisioned and
# docs/10-llm-deployment-evaluation.md has been worked through.
#
# ⚠️ **P7 blocks a FREE Google key here, and this is the deployment where it matters.** Google's
# unpaid tier may use submitted prompts to improve its products; what this sends is citizen report
# text from real people who did not agree to that. The provider choice is settled; what is NOT
# settled by that choice is the tier — enable billing on the key before pointing production at it.
# No code path can detect which tier a key is on, so this is a decision to record, not a guard.
CLASSIFICATION_LLM_PROVIDER=urbenmend.classification.llm.UnconfiguredLLMProvider
# Matches google_ai_studio. ⚠️ Ends at /v1beta — the provider appends /models/<model>:generateContent.
CLASSIFICATION_LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
CLASSIFICATION_LLM_API_KEY=
CLASSIFICATION_LLM_MODEL=gemini-2.5-flash
# ⚠️ 0 disables Gemini 2.5's reasoning, which is billed against MAX_OUTPUT_TOKENS below — raise the
# two together or the model spends an answer-sized budget thinking and returns nothing, on every
# report. Empty omits the field (required by pre-2.5 models); -1 is unbounded spend (NFR-13).
CLASSIFICATION_LLM_THINKING_BUDGET=0
CLASSIFICATION_LLM_MAX_OUTPUT_TOKENS=300
CLASSIFICATION_LLM_TIMEOUT_SECONDS=10.0
CLASSIFICATION_LLM_MAX_ATTEMPTS=2
CLASSIFICATION_LLM_BACKOFF_SECONDS=0.5
CLASSIFICATION_LLM_CACHE_SECONDS=86400
CLASSIFICATION_LLM_USER_RATE_LIMIT=20
CLASSIFICATION_LLM_GLOBAL_RATE_LIMIT=500
CLASSIFICATION_LLM_RATE_WINDOW_SECONDS=3600
CLASSIFICATION_LLM_DAILY_TOKEN_BUDGET=1000000
CLASSIFICATION_LLM_CIRCUIT_FAILURE_THRESHOLD=3
CLASSIFICATION_LLM_CIRCUIT_RECOVERY_SECONDS=60
CLASSIFICATION_FALLBACK_MATCHED_CONFIDENCE=0.5
CLASSIFICATION_FALLBACK_UNMATCHED_CONFIDENCE=0.1
# Enable after the evaluation threshold is accepted, for example 0.70.
CLASSIFICATION_LOW_CONFIDENCE_THRESHOLD=
